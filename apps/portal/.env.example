# Auth.js session encryption (openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Any OAuth2/OIDC provider with discovery. Local: the Keycloak realm from ../../infra/keycloak
OIDC_ISSUER=http://localhost:8180/realms/agents
OIDC_CLIENT_ID=agent-portal
OIDC_CLIENT_SECRET=dev-only-agent-portal-secret
OIDC_SCOPE=openid
OIDC_DISPLAY_NAME=Single sign-on
# agentgateway (server side only; the browser talks to /api/agents/{slug}/run)
GATEWAY_URL=http://localhost:4100
# Theme/branding: brands/<id>/brand.json (default). BRAND_DIR overrides the folder.
BRAND=default
