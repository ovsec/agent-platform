{
  "realm": "agents",
  "enabled": true,
  "displayName": "Agent Platform (local dev)",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "agent-user",
        "description": "Can use published agents open to all users"
      },
      {
        "name": "agent-admin",
        "description": "Platform administrator"
      },
      {
        "name": "agent-developer",
        "description": "Builds agents: Langflow Builder access"
      },
      {
        "name": "finance-support",
        "description": "Finance support team agents"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-agents"
  },
  "clientScopes": [
    {
      "name": "agent-platform",
      "description": "Platform contract: sub, aud=agent-platform, a flat `roles` array claim (like Entra app roles), name/email for display",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agent-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agent-portal",
      "name": "Agent Portal",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-agent-portal-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3100/*"
      ],
      "webOrigins": [
        "http://localhost:3100"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3100/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "agent-platform"
      ]
    },
    {
      "clientId": "agent-gateway-ui",
      "name": "agentgateway admin UI",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-agent-gateway-ui-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4101/oauth/callback"
      ],
      "webOrigins": [
        "http://localhost:4101"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "agent-platform"
      ]
    },
    {
      "clientId": "langflow-builder",
      "name": "Langflow Builder (oauth2-proxy)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-langflow-builder-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:7871/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost:7871"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "agent-platform"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Support",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-agents",
        "agent-user",
        "finance-support"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-agents",
        "agent-user"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.local",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-agents",
        "agent-user",
        "agent-admin"
      ]
    },
    {
      "username": "dev",
      "enabled": true,
      "email": "dev@example.local",
      "emailVerified": true,
      "firstName": "Dana",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-agents",
        "agent-user",
        "agent-developer"
      ]
    }
  ]
}
