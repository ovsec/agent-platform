# Copy with ./scripts/init-env.sh (fills random secrets). Local dev only.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
LANGFLOW_BUILDER_SECRET_KEY=
LANGFLOW_RUNTIME_SECRET_KEY=
LANGFLOW_RUNTIME_ADMIN_PASSWORD=
AGENTGATEWAY_OIDC_COOKIE_SECRET=
# oauth2-proxy session cookie for the Builder login (builder-login)
BUILDER_LOGIN_COOKIE_SECRET=
# Gateway API keys for runtimes and agents calling LLM/MCP on the services gateway (:4102). Any <CLIENT>_GATEWAY_KEY
# is accepted; issue one per agent, e.g. LANGCHAIN_DEMO_GATEWAY_KEY (openssl rand -hex 24)
LANGFLOW_RUNTIME_GATEWAY_KEY=
LANGFLOW_BUILDER_GATEWAY_KEY=
# Agent repos can add local wiring (Builder components, env vars, volumes) to this stack, e.g. a team's agents:
#   COMPOSE_FILE=docker-compose.yml:../my-agents/compose.platform.yaml
# Auth.js session encryption for the portal container
PORTAL_AUTH_SECRET=
BRAND=default
# Public URLs, localhost when empty. scripts/share.sh sets them to Tailscale HTTPS addresses and back.
PORTAL_URL=
IDP_URL=
GATEWAY_UI_URL=
BUILDER_URL=
