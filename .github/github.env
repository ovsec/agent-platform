# GitHub setup, read by scripts/github-setup.sh. Set ORG to the company GitHub org before running it;
# the script also replaces the ORG placeholder in .github/CODEOWNERS and in the repos it creates.
ORG=ORG
PLATFORM_TEAM=agent-platform     # org team that owns agent-platform and agent-catalog
VISIBILITY=private               # private or internal (internal needs GitHub Enterprise)
